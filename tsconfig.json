{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "rootDir": ".",
    "paths": { "#/*": ["./src/*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "gnim",
    "types": ["gi", "gnim"],
    "typeRoots": ["./.gnim/types"]
  },
  "include": ["./src/**/*"]
}
