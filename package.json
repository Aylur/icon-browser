{
  "name": "icon-browser",
  "version": "1.3.0",
  "type": "module",
  "author": "Aylur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aylur/icon-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Aylur/icon-browser/issues"
  },
  "funding": {
    "type": "kofi",
    "url": "https://ko-fi.com/aylur"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "typecheck": "tsc",
    "types": "gnim types -i Gtk-3.0 -i Gdk-3.0",
    "dev": "gnim dev src/main.tsx",
    "build": "meson setup build --wipe --prefix \"$(pwd)/dist\" ; meson install -C build"
  },
  "prettier": {
    "semi": false,
    "tabWidth": 2,
    "printWidth": 90
  },
  "dependencies": {
    "@gnim-js/gtk4": "2.0.0-beta.7",
    "gnim": "2.0.0-beta.7"
  }
}
